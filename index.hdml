<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cherry-books | Modern Online Bookstore</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .cherry-gradient { background: linear-gradient(135deg, #e11d48 0%, #be123c 100%); }
  </style>
</head>
<body class="bg-gray-50 text-gray-900">

  <!-- Top Promo Banner -->
  <div class="cherry-gradient text-white text-xs font-semibold py-2 px-4 text-center tracking-wide">
    🍒 FLASH SALE: UP TO 40% OFF BESTSELLING MODERN FICTION + FREE SHIPPING OVER $35!
  </div>

  <!-- Navbar -->
  <header class="sticky top-0 z-40 bg-white border-b border-gray-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
      <!-- Logo -->
      <a href="#" class="flex items-center gap-2 text-2xl font-extrabold tracking-tight text-rose-600">
        <span>🍒</span>
        <span>Cherry-books</span>
      </a>

      <!-- Search Bar -->
      <div class="flex-1 max-w-xl hidden sm:block">
        <div class="relative">
          <input 
            type="text" 
            id="searchInput"
            onkeyup="filterBooks()"
            placeholder="Search titles, authors, genres..." 
            class="w-full bg-gray-100 border border-transparent focus:border-rose-500 focus:bg-white rounded-full py-2 pl-4 pr-10 text-sm outline-none transition"
          />
          <span class="absolute right-3.5 top-2.5 text-gray-400">🔍</span>
        </div>
      </div>

      <!-- Cart Button -->
      <button onclick="toggleCart()" class="relative flex items-center gap-2 bg-rose-50 hover:bg-rose-100 text-rose-600 font-semibold px-4 py-2 rounded-full transition">
        <span>🛒</span>
        <span class="hidden md:inline text-sm">Bag</span>
        <span id="cartCount" class="bg-rose-600 text-white text-xs font-bold px-2 py-0.5 rounded-full">0</span>
      </button>
    </div>

    <!-- Mobile Search -->
    <div class="sm:hidden px-4 pb-3">
      <input 
        type="text" 
        id="mobileSearchInput"
        onkeyup="filterBooks(true)"
        placeholder="Search books or authors..." 
        class="w-full bg-gray-100 rounded-full py-2 px-4 text-sm outline-none"
      />
    </div>
  </header>

  <!-- Hero Section -->
  <section class="bg-rose-950 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="max-w-xl space-y-4 text-center md:text-left">
        <span class="inline-block bg-rose-600/30 border border-rose-500/40 text-rose-200 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full">
          New Arrivals 2026
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold leading-tight">
          Trending Stories, <span class="text-rose-400">Unbeatable Deals.</span>
        </h1>
        <p class="text-rose-100/80 text-sm sm:text-base">
          Discover viral BookTok hits, contemporary romance, dark academia, and modern thrillers delivered straight to your door.
        </p>
        <div class="pt-2 flex flex-wrap gap-3 justify-center md:justify-start">
          <a href="#catalog" class="bg-rose-600 hover:bg-rose-500 text-white font-bold px-6 py-3 rounded-full text-sm transition shadow-lg">
            Shop Trending
          </a>
          <button onclick="setCategory('Bestsellers')" class="bg-white/10 hover:bg-white/20 text-white font-semibold px-6 py-3 rounded-full text-sm transition">
            Daily Flash Deals
          </button>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-3 max-w-sm">
        <img src="
  
